{
  "entities": {
    "Resource": {
      "title": "Resource",
      "description": "Downloadable items like Minecraft mods, Android APKs, PC tools, source code, and guides.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 5000 },
        "category": { "type": "string", "maxLength": 50 },
        "version": { "type": "string", "maxLength": 30 },
        "downloadUrl": { "type": "string", "maxLength": 1000 },
        "mirrorUrl": { "type": "string", "maxLength": 1000 },
        "thumbnailUrl": { "type": "string", "maxLength": 1000 },
        "fileSize": { "type": "string", "maxLength": 30 },
        "downloadsCount": { "type": "number" },
        "rating": { "type": "number" },
        "ratingCount": { "type": "number" },
        "featured": { "type": "boolean" },
        "changelog": { "type": "string", "maxLength": 3000 },
        "requirements": { "type": "string", "maxLength": 1000 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["title", "description", "category", "version", "downloadUrl", "authorId"]
    },
    "ResourceRating": {
      "title": "ResourceRating",
      "description": "User-submitted star rating and optional review for a resource.",
      "type": "object",
      "properties": {
        "resourceId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userAvatar": { "type": "string", "maxLength": 200000 },
        "stars": { "type": "number" },
        "review": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["resourceId", "userId", "userName", "stars"]
    },
    "Project": {
      "title": "Project",
      "description": "Showcased projects, custom clients, open-source repositories and applications.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 120 },
        "tagline": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 5000 },
        "category": { "type": "string", "maxLength": 50 },
        "bannerUrl": { "type": "string", "maxLength": 1000 },
        "demoUrl": { "type": "string", "maxLength": 1000 },
        "githubUrl": { "type": "string", "maxLength": 1000 },
        "downloadUrl": { "type": "string", "maxLength": 1000 },
        "featured": { "type": "boolean" },
        "stars": { "type": "number" },
        "status": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["title", "tagline", "description", "category"]
    },
    "ProjectStar": {
      "title": "ProjectStar",
      "description": "Single star vote by an authenticated user for a project.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Official news, releases, devlogs, and community updates by Obsidiuss.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 150 },
        "content": { "type": "string", "maxLength": 10000 },
        "excerpt": { "type": "string", "maxLength": 300 },
        "category": { "type": "string", "maxLength": 50 },
        "pinned": { "type": "boolean" },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["title", "content", "category", "authorId"]
    },
    "Discussion": {
      "title": "Discussion",
      "description": "Community forum thread created by registered users.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 150 },
        "content": { "type": "string", "maxLength": 6000 },
        "category": { "type": "string", "maxLength": 50 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorAvatar": { "type": "string", "maxLength": 200000 },
        "authorRole": { "type": "string", "maxLength": 40 },
        "likesCount": { "type": "number" },
        "repliesCount": { "type": "number" },
        "pinned": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["title", "content", "category", "authorId", "authorName"]
    },
    "DiscussionLike": {
      "title": "DiscussionLike",
      "description": "Single like record by an authenticated user for a discussion.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Reply or comment on a discussion thread.",
      "type": "object",
      "properties": {
        "discussionId": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorAvatar": { "type": "string", "maxLength": 200000 },
        "authorRole": { "type": "string", "maxLength": 40 },
        "content": { "type": "string", "maxLength": 2000 },
        "likesCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["discussionId", "authorId", "authorName", "content"]
    },
    "Category": {
      "title": "Category",
      "description": "Admin-managed resource categories.",
      "type": "object",
      "properties": {
        "slug": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["slug", "name"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private profile details of a community member (includes PII email, owner/admin only).",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "maxLength": 80 },
        "email": { "type": "string", "maxLength": 150 },
        "photoURL": { "type": "string", "maxLength": 200000 },
        "role": { "type": "string", "maxLength": 40 },
        "bio": { "type": "string", "maxLength": 600 },
        "discordHandle": { "type": "string", "maxLength": 80 },
        "youtubeHandle": { "type": "string", "maxLength": 80 },
        "downloadsCount": { "type": "number" },
        "downloadActivity": { "type": "array" },
        "joinedAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["displayName", "role"]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Non-PII public member card for DMs, chat, and reels attribution (strictly no email).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 80 },
        "photoURL": { "type": "string", "maxLength": 200000 },
        "role": { "type": "string", "maxLength": 40 },
        "bio": { "type": "string", "maxLength": 600 },
        "discordHandle": { "type": "string", "maxLength": 80 },
        "youtubeHandle": { "type": "string", "maxLength": 80 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["uid", "displayName", "role"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Real-time message in a public community live chat channel.",
      "type": "object",
      "properties": {
        "channelId": { "type": "string", "maxLength": 40 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 80 },
        "senderAvatar": { "type": "string", "maxLength": 200000 },
        "senderRole": { "type": "string", "maxLength": 40 },
        "content": { "type": "string", "maxLength": 1000 },
        "replyToId": { "type": "string", "maxLength": 128 },
        "replyToPreview": { "type": "string", "maxLength": 160 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["channelId", "senderId", "senderName", "senderRole", "content", "createdAt"]
    },
    "DMThread": {
      "title": "DMThread",
      "description": "Private 1-on-1 direct message thread between two members.",
      "type": "object",
      "properties": {
        "participantIds": { "type": "array" },
        "participantNames": { "type": "object" },
        "participantAvatars": { "type": "object" },
        "lastMessage": { "type": "string", "maxLength": 400 },
        "lastSenderId": { "type": "string", "maxLength": 128 },
        "lastMessageAt": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["participantIds", "createdAt"]
    },
    "DMMessage": {
      "title": "DMMessage",
      "description": "Private message inside a direct message thread.",
      "type": "object",
      "properties": {
        "threadId": { "type": "string", "maxLength": 260 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 80 },
        "content": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["threadId", "senderId", "senderName", "content", "createdAt"]
    },
    "Reel": {
      "title": "Reel",
      "description": "Short-form vertical video reel shared by creators and members.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 120 },
        "caption": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 40 },
        "videoUrl": { "type": "string", "maxLength": 1500 },
        "thumbnailUrl": { "type": "string", "maxLength": 1500 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorAvatar": { "type": "string", "maxLength": 200000 },
        "authorRole": { "type": "string", "maxLength": 40 },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "viewsCount": { "type": "number" },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["title", "category", "videoUrl", "authorId", "authorName"]
    },
    "ReelLike": {
      "title": "ReelLike",
      "description": "Single like record by an authenticated user for a reel.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId"]
    },
    "ReelComment": {
      "title": "ReelComment",
      "description": "Comment on a reel video.",
      "type": "object",
      "properties": {
        "reelId": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorAvatar": { "type": "string", "maxLength": 200000 },
        "authorRole": { "type": "string", "maxLength": 40 },
        "content": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["reelId", "authorId", "authorName", "content"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "Contact form submissions and user suggestions.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 80 },
        "email": { "type": "string", "maxLength": 120 },
        "subject": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 3000 },
        "status": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["name", "email", "subject", "message"]
    },
    "Report": {
      "title": "Report",
      "description": "Flagged inappropriate content for moderation.",
      "type": "object",
      "properties": {
        "targetType": { "type": "string", "maxLength": 40 },
        "targetId": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "maxLength": 100 },
        "details": { "type": "string", "maxLength": 1000 },
        "reporterId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["targetType", "targetId", "reason", "reporterId"]
    },
    "SiteAnalytics": {
      "title": "SiteAnalytics",
      "description": "Real-time site visitor counter.",
      "type": "object",
      "properties": {
        "totalVisits": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["totalVisits"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Designated administrator user record.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "maxLength": 40 },
        "addedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/resources/{resourceId}": {
      "schema": "Resource",
      "description": "Downloadable resources and tools."
    },
    "/resources/{resourceId}/ratings/{userId}": {
      "schema": "ResourceRating",
      "description": "Individual user ratings and reviews for a resource."
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Featured projects and apps."
    },
    "/projects/{projectId}/stars/{userId}": {
      "schema": "ProjectStar",
      "description": "Individual user stars for a project."
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Creator announcements and update posts."
    },
    "/discussions/{discussionId}": {
      "schema": "Discussion",
      "description": "Community forum discussion topics."
    },
    "/discussions/{discussionId}/likes/{userId}": {
      "schema": "DiscussionLike",
      "description": "Individual user likes on a discussion thread."
    },
    "/discussions/{discussionId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Comments and replies on a discussion thread."
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Admin-managed resource categories."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profiles and account settings."
    },
    "/publicProfiles/{userId}": {
      "schema": "PublicProfile",
      "description": "Non-PII public member directory for DMs, chat, and reels."
    },
    "/chatChannels/{channelId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Real-time community live chat channel messages."
    },
    "/dmThreads/{threadId}": {
      "schema": "DMThread",
      "description": "Private 1-on-1 direct message thread metadata."
    },
    "/dmThreads/{threadId}/messages/{messageId}": {
      "schema": "DMMessage",
      "description": "Private messages within a direct message thread."
    },
    "/reels/{reelId}": {
      "schema": "Reel",
      "description": "Short-form vertical creator and community reels."
    },
    "/reels/{reelId}/likes/{userId}": {
      "schema": "ReelLike",
      "description": "Individual user likes on a reel."
    },
    "/reels/{reelId}/comments/{commentId}": {
      "schema": "ReelComment",
      "description": "Comments on a reel."
    },
    "/feedback/{feedbackId}": {
      "schema": "Feedback",
      "description": "Contact messages and community feedback."
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Moderation reports."
    },
    "/analytics/{docId}": {
      "schema": "SiteAnalytics",
      "description": "Real-time platform analytics counters."
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Administrator whitelist registry."
    }
  }
}
